print("Enter the number of boxes:")
N = int(input())

print("Enter pennies in each box:")
boxes = list(map(int, input().split()))

p1_score = 0
p2_score = 0
current_player = 1

history = []

while len(boxes) > 0:
    print(" ")
    print("Boxes:")
    print(" ".join(map(str, boxes)))
    print("Player 1 score:", p1_score)
    print("Player 2 score:", p2_score)

    print(f"Enter player {current_player} move (1 for leftmost,2 for rightmost,3 for undo):")
    move = int(input())

    if move == 3:
        if len(history) == 0:
            print("Invalid move!")
            continue

        last_player, value, position = history.pop()

        if position == "left":
            boxes.insert(0, value)
        else:
            boxes.append(value)

        if last_player == 1:
            p1_score -= value
            current_player = 1
        else:
            p2_score -= value
            current_player = 2

        continue

    if move != 1 and move != 2:
        print("Invalid move!")
        continue

    if move == 1:
        taken = boxes.pop(0)
        position = "left"
    else:
        taken = boxes.pop()
        position = "right"

    history.append((current_player, taken, position))

    if current_player == 1:
        p1_score += taken
        current_player = 2
    else:
        p2_score += taken
        current_player = 1

print("Player 1 score:", p1_score)
print("Player 2 score:", p2_score)

if p1_score > p2_score:
    print("Player 1 won!")
elif p2_score > p1_score:
    print("Player 2 won!")
else:
    print("It's a tie!")
